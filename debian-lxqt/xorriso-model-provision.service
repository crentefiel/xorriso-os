[Unit]
Description=xorriso - download oficial verificado LFM2.5-350M para HD
ConditionKernelCommandLine=!boot=live
After=network-online.target systemd-sysusers.service
Wants=network-online.target
StartLimitIntervalSec=0
OnSuccess=xorriso-model.service

[Service]
Type=oneshot
User=xorriso-model
Group=xorriso-model
UMask=0022
ExecStart=/usr/local/libexec/xorriso/model-provision.py
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=90
StateDirectory=xorriso-model
StateDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
