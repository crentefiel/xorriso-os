#!/bin/sh
set -eu
# Debian live-config/user-setup creates the 'xorriso' user at BOOT, not build.
# Pre-creating it here makes its user-setup component silently exit.
# /etc/skel is copied into the real home by user-setup after account creation.
if id xorriso >/dev/null 2>&1; then
    echo 'Refusing to pre-create xorriso user in the Live image' >&2
    exit 20
fi
mkdir -p /etc/skel/.config/lxqt /etc/skel/.config/autostart /etc/skel/.config/pcmanfm-qt/lxqt /etc/skel/Desktop /usr/local/bin
cat > /etc/skel/.config/lxqt/panel.conf <<'EOF'
[General]
__userfile__=true
panels=0
EOF
# LXQt is a session manager, not a window manager: specify Debian's XFWM4.
# Do not rely on APT Recommends to install a usable graphical window manager.
cat > /etc/skel/.config/lxqt/session.conf <<'EOF'
[General]
window_manager=xfwm4
EOF
# PCManFM-Qt manages the desktop AND provides a normal graphical file browser.
# Keep both functions; only hide its built-in Home/Trash/Computer/Network icons.
cat > /etc/skel/.config/pcmanfm-qt/lxqt/settings.conf <<'EOF'
[Behavior]
UseTrash=true
ConfirmDelete=true
[Desktop]
DesktopShortcuts=
WallpaperMode=color
BgColor=#000000
FgColor=#ffffff
[Volume]
MountOnStartup=false
AutoRun=false
EOF
cat > /etc/skel/Desktop/xorriso.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=xorriso IA
Comment=Abrir o assistente do xorriso
Exec=/usr/local/bin/xorriso-ui
Icon=system-run
Terminal=false
Categories=Utility;
EOF
cat > /etc/skel/Desktop/arquivos.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Arquivos
Comment=Gerenciar pastas e arquivos do xorriso
Exec=pcmanfm-qt
Icon=system-file-manager
Terminal=false
Categories=System;FileManager;
EOF
cat > /usr/local/bin/xorriso-ui <<'EOF'
#!/bin/sh
# Temporary launcher: never invent an AI answer or claim it executed a command.
exec /usr/bin/python3 /usr/local/bin/xorriso-ui.py
EOF
# Boot diagnostic: only an actually running LXQt desktop session can emit
# this serial marker. The QEMU smoke test must see it, not merely a lit BIOS screen.
cat > /usr/local/bin/xorriso-desktop-ready <<'EOF'
#!/bin/sh
# Launched through the LXQt session's XDG autostart, not from system boot.
# Confirm a usable desktop rather than merely a running Xorg/LXQt process.
# XFWM4, PCManFM-Qt and the X display must all be alive; wait for their autostart.
attempt=0
while [ "$attempt" -lt 90 ]; do
    if [ -n "${DISPLAY:-}" ] &&
       pgrep -u "$(id -u)" -x lxqt-session >/dev/null 2>&1 &&
       pgrep -u "$(id -u)" -x xfwm4 >/dev/null 2>&1 &&
       pgrep -u "$(id -u)" -x pcmanfm-qt >/dev/null 2>&1 &&
       /usr/bin/xset -q >/dev/null 2>&1; then
        printf '%s\n' 'XORRISO_LXQT_DESKTOP_READY' > /tmp/xorriso-desktop-ready
        # Root-owned diagnostics service forwards the marker to serial.
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done
echo 'XORRISO_LXQT_DESKTOP_COMPONENTS_NOT_READY' > /tmp/xorriso-desktop-failed
EOF
# The assistant window is the main user interface; a desktop shortcut remains
# available for relaunching it after a user closes the window.
cat > /etc/skel/.config/autostart/xorriso-ui.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=xorriso IA (iniciar com o desktop)
Exec=/usr/local/bin/xorriso-ui
Terminal=false
OnlyShowIn=LXQt;
X-LXQt-Need-Tray=false
EOF
# Global LXQt autostart survives an HD install even if the chosen user's
# home directory was created without copying the Live /etc/skel template.
# The per-user copy has the same desktop ID and wins under XDG autostart.
mkdir -p /etc/xdg/autostart
cp /etc/skel/.config/autostart/xorriso-ui.desktop /etc/xdg/autostart/xorriso-ui.desktop
cat > /etc/skel/.config/autostart/xorriso-desktop-ready.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=xorriso desktop verification
Exec=/usr/local/bin/xorriso-desktop-ready
Terminal=false
X-LXQt-Need-Tray=false
OnlyShowIn=LXQt;
EOF
chmod 755 /usr/local/bin/xorriso-desktop-ready
chmod 755 /usr/local/bin/xorriso-ui /etc/skel/Desktop/xorriso.desktop /etc/skel/Desktop/arquivos.desktop
# Trust ONLY the two launchers shipped by this ISO. Do not disable PCManFM-Qt's
# security prompts for unrelated programs (QuickExec must remain disabled).
# This runs after login, when the user's GVFS metadata daemon is available.
cat > /usr/local/bin/xorriso-trust-launchers <<'EOF'
#!/bin/sh
for desktop in "$HOME/Desktop/xorriso.desktop" "$HOME/Desktop/arquivos.desktop"; do
    [ -f "$desktop" ] || continue
    attempt=0
    while [ "$attempt" -lt 10 ]; do
        if gio set "$desktop" metadata::trusted true >/dev/null 2>&1; then
            break
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
done
EOF
cat > /etc/skel/.config/autostart/xorriso-trust-launchers.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=xorriso launcher trust
Exec=/usr/local/bin/xorriso-trust-launchers
Terminal=false
OnlyShowIn=LXQt;
X-LXQt-Need-Tray=false
EOF
chmod 755 /usr/local/bin/xorriso-trust-launchers
# Plymouth shows honest boot progress on a black background instead of a
# blank screen; 'tribar' is the distro-provided progress bar, no fake percent.
test -f /usr/share/plymouth/themes/tribar/tribar.plymouth || {
    echo 'Plymouth tribar theme missing' >&2
    exit 31
}
plymouth-set-default-theme tribar
echo 'XORRISO_PLYMOUTH_TRIBAR_CONFIGURED'
# Debian Calamares includes a helper that creates an 'Install Debian' icon
# on the desktop. The xorriso must keep exactly two desktop icons; installation
# is available through the AI interface instead. Do not disable Calamares itself.
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/calamares-desktop-icon.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Calamares desktop icon helper (disabled in xorriso)
Hidden=true
EOF
test -x /usr/bin/calamares
test -s /etc/calamares/settings.conf
test -x /usr/local/bin/xorriso-install
test -s /usr/local/share/xorriso/live-calamares.rules
# Systemd boot one-shot (not model-controlled): creates exact-purpose installer
# policy only during Live, and removes Live autologin on installed boots.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf ../xorriso-install-mode.service \
       /etc/systemd/system/multi-user.target.wants/xorriso-install-mode.service
echo 'XORRISO_LIVE_TO_HD_INSTALLER_PREPARED'

# Do not chown the skeleton to a user that does not yet exist.
# live-config/user-setup will copy and chown these files on first boot.
# Old live-build can omit the display-manager enablement in a chroot.
# Explicitly boot the graphical target and SDDM for live sessions.
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target
ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service
ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/graphical.target.wants/sddm.service
# Debug-only report for live graphical boots: useful when a VM stays black.
# Runs after the graphical target has been requested; never modifies disks.
cat > /usr/local/bin/xorriso-boot-diagnostics <<'EOF'
#!/bin/sh
sleep 60
{
    echo 'XORRISO_BOOT_DIAGNOSTICS_BEGIN'
    date -u || true
    echo 'Service enablement and status:'
    systemctl is-enabled display-manager.service || true
    systemctl is-active display-manager.service || true
    systemctl is-active sddm.service || true
    systemctl get-default || true
    ps -eo pid,user,comm,args | grep -E 'sddm|Xorg|Xwayland|lxqt-session|xfwm4|pcmanfm-qt|xorriso-ui' | grep -v grep || true
    echo 'User-session errors:'
    journalctl -b _UID=1000 --no-pager -n 90 || true
    echo 'User LXQt configuration and desktop:'
    ls -l /home/xorriso/.config/lxqt/ /home/xorriso/.config/autostart/ /home/xorriso/Desktop/ || true
    cat /home/xorriso/.config/lxqt/session.conf || true
    cat /tmp/xorriso-desktop-failed || true
    journalctl -b -u sddm.service --no-pager -n 50 || true
    systemctl --failed --no-pager || true
    echo 'XORRISO_BOOT_DIAGNOSTICS_END'
} > /dev/ttyS0 2>&1 || true
# Forward the marker only AFTER the real LXQt X11 session created it.
# This process is only a test probe; it never mounts or modifies disk volumes.
attempt=0
while [ "$attempt" -lt 170 ]; do
    if [ -f /tmp/xorriso-desktop-ready ] && 
       grep -Fxq 'XORRISO_LXQT_DESKTOP_READY' /tmp/xorriso-desktop-ready; then
        printf '%s\n' 'XORRISO_LXQT_DESKTOP_READY' > /dev/ttyS0 || true
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 3
done
echo 'XORRISO_LXQT_DESKTOP_TIMEOUT' > /dev/ttyS0 || true
EOF
chmod 755 /usr/local/bin/xorriso-boot-diagnostics
cat > /etc/systemd/system/xorriso-boot-diagnostics.service <<'EOF'
[Unit]
Description=xorriso graphical boot diagnostics for testing
ConditionKernelCommandLine=boot=live
After=systemd-journald.service
[Service]
Type=simple
ExecStart=/usr/local/bin/xorriso-boot-diagnostics
[Install]
WantedBy=multi-user.target
EOF
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf ../xorriso-boot-diagnostics.service /etc/systemd/system/multi-user.target.wants/xorriso-boot-diagnostics.service
# Enable optional, read-only volume discovery and local model service.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf ../xorriso-volumes.service /etc/systemd/system/multi-user.target.wants/xorriso-volumes.service
ln -sf ../xorriso-model.service /etc/systemd/system/multi-user.target.wants/xorriso-model.service
echo 'XORRISO_CHROOT_HOOK_EXECUTED'
