[Unit]
Description=xorriso - MiniCPM local (VDI verificados)
After=xorriso-volumes.service
Requires=xorriso-volumes.service
ConditionPathExists=/data/models/MiniCPM-V-4_7-1B-Q4_K_M.gguf
ConditionPathExists=/runtime-data/runtime/llama-server

[Service]
Type=simple
ExecStart=/usr/local/libexec/xorriso/start-model.sh
Restart=on-failure
RestartSec=8
TimeoutStartSec=30
# Root here is confined: original VDI directories may be owner-only on ext4.
# This model service has no administrative command execution endpoint.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/run/xorriso
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
