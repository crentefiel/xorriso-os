[Unit]
Description=xorriso - LFM2.5-350M local localhost:8080
ConditionPathExists=|/usr/share/xorriso/models/model.json
ConditionPathExists=|/var/lib/xorriso-model/model.json
After=xorriso-model-provision.service
Wants=xorriso-model-provision.service

[Service]
Type=simple
User=xorriso-model
Group=xorriso-model
ExecStart=/usr/local/libexec/xorriso/start-model.sh
Restart=on-failure
RestartSec=20
TimeoutStartSec=300
StateDirectory=xorriso-model
StateDirectoryMode=0755
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
